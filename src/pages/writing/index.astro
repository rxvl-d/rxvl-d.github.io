---
import Base from '../../layouts/Base.astro';

const modules = import.meta.glob<{ frontmatter: { title: string; date: string; description?: string } }>(
  '../../posts/*.md',
  { eager: true },
);

const posts = Object.entries(modules)
  .map(([file, mod]) => ({
    slug: file.split('/').pop()!.replace(/\.md$/, ''),
    ...mod.frontmatter,
  }))
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());

const format = (d: string) =>
  new Date(d).toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' });
---

<Base title="Writing" section="yellow" description="Blog posts by Ratan Sebastian.">
  <div class="page wrap">
    <h1 class="page-title">Writing</h1>
    {
      posts.length === 0 ? (
        <p class="page-intro">No posts yet.</p>
      ) : (
        <ul class="posts">
          {posts.map((p) => (
            <li>
              <a href={`/writing/${p.slug}`}>{p.title}</a>
              <time datetime={p.date}>{format(p.date)}</time>
              {p.description && <p>{p.description}</p>}
            </li>
          ))}
        </ul>
      )
    }
  </div>
</Base>

<style>
  .posts {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .posts li {
    display: grid;
    padding-block: 1.25rem;
    border-top: 0.25rem solid var(--black);
  }

  .posts a {
    font-family: var(--display);
    font-weight: 800;
    font-size: clamp(1.6rem, 3.5vw, 2.4rem);
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  time {
    margin-block: 0.4rem;
  }

  .posts p {
    margin: 0;
  }
</style>
